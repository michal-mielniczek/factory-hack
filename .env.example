# ============================================================
# Factory Hack - Environment Variables
# ============================================================
# Copy this file to .env and fill in actual values after
# running challenge-0/get-keys.sh
# ============================================================

# --- Azure Resource Group ---
RESOURCE_GROUP=rg-tire-factory-hack-<initials>
LOCATION=swedencentral

# --- Azure Cosmos DB ---
COSMOS_ENDPOINT=https://your-cosmos-account.documents.azure.com:443/
COSMOS_KEY=your-cosmos-key
COSMOS_DATABASE_NAME=FactoryOpsDB

# --- Azure AI Foundry / Project ---
# Canonical name used by all agent code:
AZURE_AI_PROJECT_ENDPOINT=https://your-hub-name.services.ai.azure.com/api/projects/your-project-name
AZURE_AI_PROJECT_RESOURCE_ID=/subscriptions/.../resourceGroups/.../providers/Microsoft.MachineLearningServices/workspaces/your-project

# --- Model Deployment ---
MODEL_DEPLOYMENT_NAME=gpt-4.1

# --- Azure OpenAI ---
AZURE_OPENAI_SERVICE_NAME=your-openai-service-name
AZURE_OPENAI_ENDPOINT=https://your-openai.openai.azure.com/

# --- Azure AI Search ---
SEARCH_SERVICE_NAME=your-search-service
SEARCH_SERVICE_ENDPOINT=https://your-search-service.search.windows.net

# --- Azure Storage ---
STORAGE_ACCOUNT_NAME=your-storage-account
STORAGE_ACCOUNT_KEY=your-storage-key

# --- Azure API Management ---
APIM_NAME=your-apim-name
APIM_SUBSCRIPTION_KEY=your-apim-subscription-key

# --- MCP Server Endpoints (created in Challenge-1 Task 2.2) ---
MACHINE_MCP_SERVER_ENDPOINT=https://your-apim.azure-api.net/mcp/machine-data
MAINTENANCE_MCP_SERVER_ENDPOINT=https://your-apim.azure-api.net/mcp/maintenance-data

# --- Azure Container Registry ---
CONTAINER_REGISTRY_NAME=your-acr-name

# --- Observability ---
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=00000000-0000-0000-0000-000000000000;IngestionEndpoint=https://your-region.in.applicationinsights.azure.com/
LOG_ANALYTICS_WORKSPACE_ID=your-workspace-id

# --- Azure Subscription ---
AZURE_SUBSCRIPTION_ID=your-subscription-id
